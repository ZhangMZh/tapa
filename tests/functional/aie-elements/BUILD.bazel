load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

cc_binary(
    name = "aie-elements-host",
    srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    deps = [
        "//tapa-lib:tapa-host",
        "@gflags",
    ],
)

sh_test(
    name = "aie-elements",
    size = "small",
    srcs = ["//bazel:sim_env.sh"],
    args = ["$(rootpath :aie-elements-host)"],
    data = [":aie-elements-host"],
)

# Whole-word generic and non-native vector element I/O. Developer-run (needs
# Vitis with aiecompiler): not part of `bazel test //...`.
sh_test(
    name = "aie-elements-x86sim",
    size = "medium",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath //bazel:run_aiesim.sh)",
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :aie-elements-host)",
        "$(rootpath element.cpp)",
        "Elements",
        "--",
        "--arg=n=5",
        "--part-num=xcvc1902-vsva2197-2MP-e-S",
    ],
    data = [
        "element.cpp",
        "element.h",
        ":aie-elements-host",
        "//bazel:run_aiesim.sh",
        "//tapa-core:tapa",
    ],
    tags = ["manual"],
)
